{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/price-check", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/deals-refresh", "schedule": "30 */6 * * *" }
  ]
}
