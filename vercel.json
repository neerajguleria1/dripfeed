{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/cron/:path*", "destination": "/api/cron/:path*" },
    { "source": "/api/:path*", "destination": "/api/[[...route]]" },
    { "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|favicon\\.svg|offline\\.html|sitemap\\.xml|robots\\.txt|google[a-z0-9]+\\.html|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/price-check", "schedule": "0 6 * * *" },
    { "path": "/api/cron/deals-refresh", "schedule": "0 18 * * *" }
  ]
}
